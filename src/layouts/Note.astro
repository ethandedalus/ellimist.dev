---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "~/components/FormattedDate.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { tagSlug } from "~/lib/tags";

type Props = CollectionEntry<"notes">["data"];

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;
---

<BaseLayout title={title} description={description ?? title}>
  <article class="mx-auto w-full max-w-2xl px-4 py-10 sm:px-6">
    <a
      href="/notes"
      class="text-muted-foreground hover:text-primary mb-8 inline-block text-sm transition-colors"
    >
      &larr; All notes
    </a>

    <header class="mb-6">
      <div
        class="text-muted-foreground flex flex-wrap items-center gap-2 text-sm"
      >
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span class="italic">
                Updated <FormattedDate date={updatedDate} />
              </span>
            </>
          )
        }
      </div>

      <h1
        class="text-foreground mt-2 text-2xl font-bold tracking-tight text-balance"
      >
        {title}
      </h1>

      {
        tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
            {tags.map((tag) => (
              <li>
                <a
                  href={`/blog?tag=${tagSlug(tag)}`}
                  class="tag-link"
                >
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose prose-neutral dark:prose-invert max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
