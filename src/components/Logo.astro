---
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 35 35"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
  <circle cx="17.5" cy="17.5" r="12.5"></circle>
  <ellipse cx="9.5" cy="8.5" rx="4.5" ry="3.5"></ellipse>
  <ellipse cx="25.5" cy="8.5" rx="4.5" ry="3.5"></ellipse>
</svg>
