---
import HeaderLink from "~/components/HeaderLink.astro";
import HeaderSearch from "~/components/HeaderSearch.svelte";
import Logo from "~/components/Logo.astro";
import ThemeToggle from "~/components/ThemeToggle.svelte";
import { SITE_TITLE } from "~/consts";
import { getSearchIndexVersion } from "~/lib/search-index";

const version = await getSearchIndexVersion();
---

<header
  class="border-border bg-background/80 sticky top-0 z-40 w-full border-b backdrop-blur-sm"
>
  <nav
    class="mx-auto flex w-full max-w-3xl flex-wrap items-center gap-x-3 gap-y-2 px-4 py-2 sm:h-14 sm:flex-nowrap sm:gap-4 sm:px-6 sm:py-0"
  >
    <a
      href="/"
      class="text-foreground group flex shrink-0 items-center gap-2"
      aria-label={`${SITE_TITLE} — home`}
    >
      <Logo
        size={22}
        class="text-foreground transition-transform duration-300 group-hover:-rotate-12"
      />
      <span
        class="border-border bg-muted text-foreground group-hover:border-primary group-hover:text-primary group-hover:bg-primary/10 hidden rounded-md border px-2 py-0.5 font-mono text-sm font-bold tracking-tight transition-colors sm:inline"
      >
        // {SITE_TITLE}
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-1">
      <HeaderLink href="/blog">Posts</HeaderLink>
      <HeaderLink href="/notes">Notes</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </div>

    <div
      class="order-last w-full min-w-0 sm:order-0 sm:flex sm:w-auto sm:flex-1 sm:justify-end"
    >
      <HeaderSearch client:load {version} />
    </div>

    <div class="ml-auto sm:ml-0">
      <ThemeToggle client:load />
    </div>
  </nav>
</header>
