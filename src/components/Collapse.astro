---
// Opt-in collapsible block for material a reader can skip — a derivation, a
// proof, an aside. Closed by default, since the point is to signal "skippable".
//
//   import Collapse from "~/components/Collapse.astro";
//
//   <Collapse summary="Why majorities must intersect">
//     ...
//   </Collapse>
//
// `open` starts it expanded. `border` frames it; without it the block is bare.

interface Props {
  summary: string;
  open?: boolean;
  border?: boolean;
}

const { summary, open = false, border = false } = Astro.props;
---

<details class="collapse-block" open={open} data-border={border || undefined}>
  <summary>
    <svg
      class="collapse-marker"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.25"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <line class="collapse-marker-bar" x1="12" y1="5" x2="12" y2="19"></line>
    </svg>
    <span>{summary}</span>
  </summary>
  <div class="collapse-body">
    <slot />
  </div>
</details>
