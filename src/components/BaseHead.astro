---
import "~/styles/global.css";
import "katex/dist/katex.min.css";
import { SITE_TITLE } from "~/consts";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	description: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description } = Astro.props;

const socialImage = new URL("/og-default.png", Astro.url);
---

<!--
	Applies the theme before first paint so there is no flash of the wrong
	mode. Must stay inline and must run before any stylesheet renders.
-->
<script is:inline>
	(() => {
		const applyTheme = () => {
			try {
				const stored = localStorage.getItem("theme");
				const dark = stored
					? stored === "dark"
					: window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle("dark", dark);
			} catch (e) {
				console.error(e);
			}
		};

		applyTheme();

		// A view transition swaps in the incoming document's `<html>`
		// attributes, which drops the `dark` class the toggle set. `after-swap`
		// runs before the new page is painted, so re-applying here is invisible.
		if (!window.__themeSwapBound) {
			window.__themeSwapBound = true;
			document.addEventListener("astro:after-swap", applyTheme);

			// `scroll-behavior: smooth` would otherwise animate the router's
			// jump to the top of the next page, which reads as a lurch
			// underneath the fade. In-page anchors keep their smooth scroll.
			const root = document.documentElement;
			document.addEventListener("astro:before-swap", () => {
				root.style.scrollBehavior = "auto";
			});
			document.addEventListener("astro:page-load", () => {
				root.style.scrollBehavior = "";
			});
		}
	})();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta
	name="theme-color"
	media="(prefers-color-scheme: light)"
	content="#f9f9f9"
/>
<meta
	name="theme-color"
	media="(prefers-color-scheme: dark)"
	content="#121214"
/>
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<ClientRouter />

<Font cssVariable="--font-catamaran" preload />
<Font cssVariable="--font-newsreader" preload />
<Font cssVariable="--font-jetbrains-mono" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImage} />
