---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { isVisible } from '~/lib/types';

export async function getStaticPaths() {
	const posts = await getCollection('blog', isVisible);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);

// Neighbours within the same series, for the table of contents. Ordered by
// `seriesPart`, which the schema requires whenever `series` is set.
const link = (entry: CollectionEntry<'blog'>) => ({
	title: entry.data.title,
	href: `/blog/${entry.id}/`,
	part: entry.data.seriesPart,
});

let seriesPrev: ReturnType<typeof link> | undefined;
let seriesNext: ReturnType<typeof link> | undefined;

if (post.data.series) {
	const siblings = (
		await getCollection(
			'blog',
			(entry) => isVisible(entry) && entry.data.series === post.data.series,
		)
	).sort((a, b) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0));

	const index = siblings.findIndex((entry) => entry.id === post.id);
	if (index > 0) seriesPrev = link(siblings[index - 1]);
	if (index >= 0 && index < siblings.length - 1) {
		seriesNext = link(siblings[index + 1]);
	}
}
---

<BlogPost
	{...post.data}
	headings={headings}
	seriesPrev={seriesPrev}
	seriesNext={seriesNext}
>
	<Content />
</BlogPost>
